<Window x:Class="PandaPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панда-помощник"
        Width="350" Height="435"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Storyboard x:Key="IdleAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PandaBob"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-5" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PandaScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.008" Duration="0:0:2.2" />
        </Storyboard>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="SpeechCard"
                Width="326"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Padding="17,14"
                CornerRadius="22"
                Background="#F7FFFDFB"
                BorderBrush="#DDEBE6"
                BorderThickness="1"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="SpeechTitle"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               DockPanel.Dock="Left" />
                    <Button Content="×"
                            Width="28" Height="28"
                            Padding="0"
                            Margin="8,-5,-6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Foreground="#70827C"
                            BorderThickness="0"
                            FontSize="18"
                            Click="HideSpeech_Click" />
                </DockPanel>
                <TextBlock x:Name="SpeechDetail"
                           Margin="0,5,0,0"
                           Foreground="#52615C"
                           FontSize="13.5"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="ReminderActions"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <Button Content="Готово"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CompleteReminder_Click" />
                    <Button Content="Через 5 минут"
                            Margin="8,0,0,0"
                            Style="{StaticResource SoftButtonStyle}"
                            Click="SnoozeReminder_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="CompactTab"
                Width="76" Height="76"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="5,0,0,12"
                CornerRadius="38"
                Background="#F7FFFDFB"
                BorderBrush="#BFDCD2"
                BorderThickness="2"
                Visibility="Collapsed"
                Cursor="Hand"
                Panel.ZIndex="6"
                ToolTip="Нажмите, чтобы вернуть панду"
                MouseLeftButtonDown="CompactTab_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" />
            </Border.Effect>
            <Image Source="/Assets/panda-idle.png" Stretch="Uniform" Margin="5" />
        </Border>

        <Button x:Name="SettingsButton"
                Width="38" Height="38"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,17,16"
                Padding="0"
                Content="⚙"
                FontSize="18"
                Foreground="{StaticResource InkBrush}"
                Background="#EFFFFFFF"
                BorderBrush="#D8E8E2"
                BorderThickness="1"
                Cursor="Hand"
                Panel.ZIndex="3"
                Click="Settings_Click" />

        <Grid x:Name="PandaVisual"
              Width="286" Height="286"
              Margin="0,0,24,4"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              RenderTransformOrigin="0.5,0.9"
              MouseLeftButtonDown="Panda_MouseLeftButtonDown"
              MouseRightButtonUp="Panda_MouseRightButtonUp"
              ToolTip="Один щелчок — пообщаться, двойной — свернуть"
              RenderOptions.BitmapScalingMode="HighQuality"
              SnapsToDevicePixels="False"
              Cursor="Hand">
            <Grid.CacheMode>
                <BitmapCache RenderAtScale="1.35" />
            </Grid.CacheMode>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PandaScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PandaRotate" Angle="0" />
                    <TranslateTransform x:Name="PandaBob" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="PandaImage"
                   Source="/Assets/panda-idle.png"
                   Stretch="Uniform"
                   Opacity="1" />

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Поздороваться" Click="Greeting_Click" />
                    <MenuItem Header="Проверить напоминание" Click="TestReminder_Click" />
                    <Separator />
                    <MenuItem Header="Настройки" Click="Settings_Click" />
                    <MenuItem Header="Закрыть панду" Click="Exit_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Grid>
</Window>
