<Window x:Class="PandaPet.ParentAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Родительский режим"
        Width="420" Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF9F0">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Text="Родительский режим"
                       FontSize="25" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock x:Name="DescriptionText"
                       Margin="0,7,0,20"
                       Text="Введите четырёхзначный PIN, чтобы открыть настройки."
                       FontSize="14" Foreground="#65736E"
                       TextWrapping="Wrap" />

            <TextBlock Text="PIN" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <PasswordBox x:Name="PinBox"
                         Margin="0,7,0,0"
                         Padding="10,8"
                         MaxLength="4"
                         FontSize="18" />

            <StackPanel x:Name="ConfirmationPanel" Margin="0,13,0,0" Visibility="Collapsed">
                <TextBlock Text="Повторите PIN" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <PasswordBox x:Name="ConfirmPinBox"
                             Margin="0,7,0,0"
                             Padding="10,8"
                             MaxLength="4"
                             FontSize="18" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="#C34F4F"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Margin="0,0,10,0"
                    Style="{StaticResource SoftButtonStyle}"
                    Click="Cancel_Click" />
            <Button x:Name="ContinueButton"
                    Content="Открыть настройки"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
